# ── SchoolVerse API ─────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# MongoDB connection string. MUST be a replica set (transactions are used).
# Atlas clusters work out of the box. Local: run `mongod --replSet rs0` then `rs.initiate()`.
MONGODB_URI=

# JWT secrets — at least 32 random characters each.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Token lifetimes
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Frontend origin (allowed by CORS)
WEB_ORIGIN=http://localhost:5180

# Set to true when served over HTTPS
COOKIE_SECURE=false

LOG_LEVEL=info
