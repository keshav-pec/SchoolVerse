# ── SchoolVerse API ─────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# MongoDB connection string. MUST be a replica set (transactions are used).
# Atlas clusters work out of the box. Local: run `mongod --replSet rs0` then `rs.initiate()`.
MONGODB_URI=

# JWT secrets — at least 32 random characters each.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Token lifetimes
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Frontend origin (allowed by CORS)
WEB_ORIGIN=http://localhost:5180

# Set to true when served over HTTPS
COOKIE_SECURE=false

# Folder for uploaded files such as school logos (served at /uploads)
UPLOAD_DIR=uploads

# Private files (employee documents, exports). Never served statically.
PRIVATE_UPLOAD_DIR=private-uploads

# Field encryption for government IDs and bank details, newest key first. The first key encrypts; all of them can decrypt,
# so rotate by adding a new key in front. Each key is 32 random bytes, base64.
#   node -e "console.log('v1:' + require('crypto').randomBytes(32).toString('base64'))"
# Development falls back to a fixed key; production refuses to start without these two.
FIELD_ENCRYPTION_KEYS=
# Signs download links. At least 32 random characters.
FILE_URL_SECRET=

# Where the web app lives, for the links in activation and reset emails (defaults to WEB_ORIGIN).
APP_BASE_URL=

# Emails go to the dev_outbox collection and /api/v1/dev/outbox instead of being sent. On outside production.
# Set to true on a demo deployment so the demo can activate accounts without an email provider.
DEV_OUTBOX=

LOG_LEVEL=info
